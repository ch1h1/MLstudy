
import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics.pairwise import cosine_similarity
from datetime import datetime, timedelta
from scipy.optimize import linear_sum_assignment
import matplotlib.pyplot as plt
import seaborn as sns

# 日本語フォント設定

plt.rcParams[‘font.sans-serif’] = [‘DejaVu Sans’]
plt.rcParams[‘axes.unicode_minus’] = False

class TimeSeriesClusteringWithTracking:
def **init**(self, n_clusters=3, similarity_threshold=0.7, overlap_threshold=0.3):
“””
時系列クラスタリング with クラスタ追跡

```
    Parameters:
    -----------
    n_clusters : int
        各ウィンドウでのクラスタ数
    similarity_threshold : float
        クラスタ中心の類似度閾値（これ以上で同一クラスタと判定）
    overlap_threshold : float
        クラスタメンバーの重複度閾値（これ以上で同一クラスタと判定）
    """
    self.n_clusters = n_clusters
    self.similarity_threshold = similarity_threshold
    self.overlap_threshold = overlap_threshold
    self.global_cluster_counter = 0
    self.cluster_history = []
    
def generate_dummy_data(self, n_samples=100, n_features=5, n_days=365):
    """
    ダミーの時系列データを生成（効率化版）
    """
    dates = pd.date_range(start='2024-01-01', periods=n_days, freq='D')
    
    # 一度に全データを生成（ループを減らす）
    total_samples = n_samples
    n_per_day = total_samples // n_days
    
    # 日付インデックスを先に生成
    date_indices = np.repeat(np.arange(n_days), n_per_day)
    sample_dates = dates[date_indices]
    
    # 季節性と週周期を一括計算
    seasonal_values = np.sin(2 * np.pi * date_indices / 365) * 2
    weekly_values = np.sin(2 * np.pi * date_indices / 7) * 1.5
    
    # 特徴量を一括生成
    n_actual_samples = len(date_indices)
    features = np.random.randn(n_actual_samples, n_features)
    features[:, 0] += seasonal_values
    features[:, 1] += weekly_values
    
    # DataFrameを一度に構築
    df = pd.DataFrame(features, columns=[f'feature_{i}' for i in range(n_features)])
    df['date'] = sample_dates
    df['sample_id'] = np.arange(n_actual_samples)
    
    return df

def calculate_member_overlap_batch(self, prev_members, curr_members):
    """
    メンバー重複度を一括計算（効率化）
    """
    n_prev = len(prev_members)
    n_curr = len(curr_members)
    overlap_matrix = np.zeros((n_prev, n_curr))
    
    # 集合を事前に作成
    prev_sets = [set(members) for members in prev_members]
    curr_sets = [set(members) for members in curr_members]
    
    for i, set1 in enumerate(prev_sets):
        for j, set2 in enumerate(curr_sets):
            if len(set1) == 0 or len(set2) == 0:
                continue
            intersection = len(set1 & set2)
            union = len(set1 | set2)
            overlap_matrix[i, j] = intersection / union if union > 0 else 0.0
    
    return overlap_matrix

def match_clusters_optimized(self, prev_window_info, curr_centers, curr_members_ids):
    """
    最適化されたクラスタマッチング（ハンガリアンアルゴリズム使用）
    """
    if prev_window_info is None:
        # 最初のウィンドウ：新規クラスタとして割り当て
        global_labels = np.arange(self.global_cluster_counter, 
                                 self.global_cluster_counter + self.n_clusters)
        self.global_cluster_counter += self.n_clusters
        return global_labels
    
    prev_centers = prev_window_info['centers']
    prev_members = prev_window_info['members']
    prev_global_labels = prev_window_info['global_labels']
    
    # 類似度とオーバーラップを一括計算
    similarity_matrix = cosine_similarity(prev_centers, curr_centers)
    overlap_matrix = self.calculate_member_overlap_batch(prev_members, curr_members_ids)
    
    # マッチングスコア（コストに変換：最大化→最小化）
    matching_score = (similarity_matrix + overlap_matrix) / 2
    cost_matrix = 1 - matching_score  # コスト化
    
    # ハンガリアンアルゴリズムで最適マッチング
    row_ind, col_ind = linear_sum_assignment(cost_matrix)
    
    # グローバルラベルを割り当て
    global_labels = np.full(self.n_clusters, -1, dtype=int)
    
    for prev_idx, curr_idx in zip(row_ind, col_ind):
        # 閾値チェック
        if (similarity_matrix[prev_idx, curr_idx] >= self.similarity_threshold or 
            overlap_matrix[prev_idx, curr_idx] >= self.overlap_threshold):
            # 既存クラスタを継承
            global_labels[curr_idx] = prev_global_labels[prev_idx]
    
    # マッチしなかったクラスタは新規
    unmatched_mask = (global_labels == -1)
    n_unmatched = np.sum(unmatched_mask)
    global_labels[unmatched_mask] = np.arange(
        self.global_cluster_counter, 
        self.global_cluster_counter + n_unmatched
    )
    self.global_cluster_counter += n_unmatched
    
    return global_labels

def sliding_window_clustering(self, df, window_days=30, slide_days=7):
    """
    スライディングウィンドウでクラスタリングを実行（効率化版）
    """
    feature_cols = [col for col in df.columns if col.startswith('feature_')]
    
    start_date = df['date'].min()
    end_date = df['date'].max()
    
    # ウィンドウ開始日を事前計算
    window_starts = []
    current_date = start_date
    while current_date + timedelta(days=window_days) <= end_date:
        window_starts.append(current_date)
        current_date += timedelta(days=slide_days)
    
    n_windows = len(window_starts)
    print(f"Processing {n_windows} windows...")
    
    # 結果格納用の配列を事前確保
    df['global_cluster'] = -1
    df['window_id'] = -1
    df['local_cluster'] = -1
    
    prev_window_info = None
    
    for window_id, window_start in enumerate(window_starts):
        window_end = window_start + timedelta(days=window_days)
        
        # ウィンドウマスク（ベクトル化された比較）
        mask = (df['date'] >= window_start) & (df['date'] < window_end)
        window_indices = np.where(mask)[0]
        
        if len(window_indices) < self.n_clusters:
            continue
        
        # クラスタリング実行
        X = df.loc[window_indices, feature_cols].values
        kmeans = KMeans(n_clusters=self.n_clusters, random_state=42, n_init=10)
        local_labels = kmeans.fit_predict(X)
        
        # クラスタメンバーをリスト化（効率的に）
        members_ids = [df.loc[window_indices[local_labels == i], 'sample_id'].values 
                      for i in range(self.n_clusters)]
        
        # クラスタマッチング
        global_labels = self.match_clusters_optimized(
            prev_window_info, 
            kmeans.cluster_centers_, 
            members_ids
        )
        
        # 結果を一括代入（.loc使用で効率化）
        df.loc[window_indices, 'local_cluster'] = local_labels
        df.loc[window_indices, 'global_cluster'] = global_labels[local_labels]
        df.loc[window_indices, 'window_id'] = window_id
        
        # 次のウィンドウのために情報を保存
        prev_window_info = {
            'centers': kmeans.cluster_centers_,
            'members': members_ids,
            'global_labels': global_labels
        }
        
        self.cluster_history.append({
            'window_id': window_id,
            'window_start': window_start,
            'window_end': window_end,
            'global_labels': global_labels.tolist(),
            'n_samples': len(window_indices)
        })
        
        if (window_id + 1) % 10 == 0:
            print(f"  Processed {window_id + 1}/{n_windows} windows")
    
    # 結果が割り当てられた行のみを返す
    results_df = df[df['window_id'] >= 0].copy()
    
    # window_start, window_endを追加
    window_info = pd.DataFrame(self.cluster_history)[['window_id', 'window_start', 'window_end']]
    results_df = results_df.merge(window_info, on='window_id', how='left')
    
    return results_df

def visualize_results(self, results_df):
    """
    クラスタリング結果を可視化
    """
    fig, axes = plt.subplots(3, 1, figsize=(15, 12))
    
    # 1. 各ウィンドウでのクラスタ分布（効率化）
    window_cluster_counts = results_df.groupby(['window_id', 'global_cluster'], 
                                               observed=True).size().unstack(fill_value=0)
    
    ax1 = axes[0]
    window_cluster_counts.plot(kind='bar', stacked=True, ax=ax1, colormap='tab20')
    ax1.set_title('Window-wise Cluster Distribution', fontsize=14, fontweight='bold')
    ax1.set_xlabel('Window ID')
    ax1.set_ylabel('Number of Samples')
    ax1.legend(title='Global Cluster', bbox_to_anchor=(1.05, 1), loc='upper left')
    ax1.grid(axis='y', alpha=0.3)
    
    # 2. グローバルクラスタの時間的推移（ベクトル化）
    ax2 = axes[2]
    cluster_presence = results_df.groupby(['window_id', 'global_cluster'], 
                                         observed=True).size().unstack(fill_value=0)
    
    for cluster_id in cluster_presence.columns:
        ax2.plot(cluster_presence.index, cluster_presence[cluster_id], 
                marker='o', label=f'Cluster {cluster_id}', linewidth=2, markersize=4)
    
    ax2.set_title('Cluster Presence Over Time', fontsize=14, fontweight='bold')
    ax2.set_xlabel('Window ID')
    ax2.set_ylabel('Number of Samples in Cluster')
    ax2.legend(bbox_to_anchor=(1.05, 1), loc='upper left', ncol=2)
    ax2.grid(True, alpha=0.3)
    
    # 3. 特徴空間での可視化（サンプリングで効率化）
    ax3 = axes[1]
    
    last_window = results_df['window_id'].max()
    last_window_data = results_df[results_df['window_id'] == last_window]
    
    # データが多い場合はサンプリング
    if len(last_window_data) > 1000:
        last_window_data = last_window_data.sample(n=1000, random_state=42)
    
    scatter = ax3.scatter(last_window_data['feature_0'], 
                         last_window_data['feature_1'],
                         c=last_window_data['global_cluster'],
                         cmap='tab20',
                         s=50,
                         alpha=0.6,
                         edgecolors='black',
                         linewidth=0.5)
    
    ax3.set_title(f'Feature Space (Last Window: {last_window})', fontsize=14, fontweight='bold')
    ax3.set_xlabel('Feature 0')
    ax3.set_ylabel('Feature 1')
    plt.colorbar(scatter, ax=ax3, label='Global Cluster')
    ax3.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.show()
    
    return fig
```

# メイン実行

if **name** == “**main**”:
print(”=” * 60)
print(“Time Series Clustering with Sliding Window (Optimized)”)
print(”=” * 60)

```
# クラスタリングシステムの初期化
clustering = TimeSeriesClusteringWithTracking(
    n_clusters=3,
    similarity_threshold=0.7,
    overlap_threshold=0.3
)

# ダミーデータ生成
print("\n[1] Generating dummy data...")
df = clustering.generate_dummy_data(n_samples=5000, n_features=5, n_days=365)
print(f"Generated {len(df)} samples over {df['date'].nunique()} days")
print(f"Features: {[col for col in df.columns if col.startswith('feature_')]}")
print(f"Memory usage: {df.memory_usage(deep=True).sum() / 1024**2:.2f} MB")

# スライディングウィンドウクラスタリング実行
print("\n[2] Running sliding window clustering...")
print(f"Window size: 30 days, Slide: 7 days")

import time
start_time = time.time()
results_df = clustering.sliding_window_clustering(df, window_days=30, slide_days=7)
elapsed_time = time.time() - start_time

print(f"\nProcessing time: {elapsed_time:.2f} seconds")
print(f"Total windows processed: {results_df['window_id'].nunique()}")
print(f"Total global clusters created: {clustering.global_cluster_counter}")
print(f"Unique global clusters in results: {results_df['global_cluster'].nunique()}")

# 統計情報表示
print("\n[3] Cluster Statistics:")
print("-" * 60)
cluster_stats = results_df.groupby('global_cluster', observed=True).agg({
    'sample_id': 'count',
    'window_id': ['min', 'max', 'nunique']
})
cluster_stats.columns = ['total_samples', 'first_window', 'last_window', 'n_windows']
cluster_stats['lifespan'] = cluster_stats['last_window'] - cluster_stats['first_window'] + 1
print(cluster_stats.head(20))

# 可視化
print("\n[4] Visualizing results...")
clustering.visualize_results(results_df)

# サンプル表示
print("\n[5] Sample Results (first 10 rows):")
print("-" * 60)
display_cols = ['date', 'window_id', 'local_cluster', 'global_cluster', 'feature_0', 'feature_1']
print(results_df[display_cols].head(10).to_string(index=False))

print("\n" + "=" * 60)
print("Clustering completed successfully!")
print("=" * 60)
